  {
    "id": "fn_rota",
    "type": "function",
    "name": "Rotear topicos",
    "func": "var t = msg.topic;\nvar v = msg.payload;\nif (t.endsWith('/temperature')) {\n  flow.set('temp', parseFloat(v));\n  node.send([{payload: parseFloat(v)}, null, null, null, null]);\n}\nelse if (t.endsWith('/humidity')) {\n  flow.set('umid', parseFloat(v));\n  node.send([null, {payload: parseFloat(v)}, null, null, null]);\n}\nelse if (t.endsWith('/ldr')) {\n  flow.set('ldr', parseInt(v));\n  node.send([null, null, {payload: parseInt(v)}, null, null]);\n}\nelse if (t.endsWith('/gas')) {\n  flow.set('gas', parseInt(v));\n  node.send([null, null, null, {payload: parseInt(v)}, null]);\n}\nelse if (t.endsWith('/motion')) {\n  flow.set('motion', v);\n  node.send([null, null, null, null, {payload: v}]);\n}\nreturn null;",
    "outputs": 5,
    "noerr": 0,
    "initialize": "", "finalize": "", "libs": [],
    "x": 380, "y": 100,
    "wires": [
      ["gauge_temp", "chart_temp", "fn_temp_check"],
      ["gauge_umid", "chart_umid"],
      ["gauge_ldr"],
      ["gauge_gas", "fn_gas_check"],
      ["template_pir"]
    ]
  },
