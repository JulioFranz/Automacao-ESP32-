  {
    "id": "fn_collect",
    "type": "function",
    "name": "Coletar dados",
    "func": "var t = flow.get('temp')   || 0;\nvar u = flow.get('umid')   || 0;\nvar l = flow.get('ldr')    || 0;\nvar g = flow.get('gas')    || 0;\nvar m = flow.get('motion') || 'OFF';\nmsg.url = 'https://script.google.com/macros/s/AKfycbyW_Fj7VG-a7oOAJUlYtFZs12rgTKoOQBf_26K1TOVB7LqHq9NyRMTSNZH134MawYQJgg/exec'\n  + '?temperature=' + t\n  + '&humidity='    + u\n  + '&ldr='         + l\n  + '&gas='         + g\n  + '&motion='      + m;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "", "finalize": "", "libs": [],
    "x": 370, "y": 900,
    "wires": [["http_sheets"]]
