  {
    "id": "fn_gas_check",
    "type": "function",
    "name": "Checar alerta gas",
    "func": "var lastAlert = flow.get('lastGasAlert') || 0;\nvar now = Date.now();\nvar isAlert = (msg.payload === 'ALERTA') || (parseInt(msg.payload) > 2000);\nif (isAlert && (now - lastAlert) > 300000) {\n  flow.set('lastGasAlert', now);\n  msg.to = 'minerandon@gmail.com';\n  msg.topic = '[ALERTA] Vazamento de Gas - Casa Inteligente';\n  msg.payload = 'ALERTA DE SEGURANCA!\\n\\nSensor MQ-2 detectou nivel perigoso de gas.\\nHorario: ' + new Date().toLocaleString('pt-BR') + '\\n\\nVerifique imediatamente a residencia!';\n  return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "", "finalize": "", "libs": [],
    "x": 900, "y": 300,
    "wires": [["email_alert"]]
  },
  {
    "id": "fn_temp_check",
    "type": "function",
    "name": "Checar alerta temp",
    "func": "var lastAlert = flow.get('lastTempAlert') || 0;\nvar now = Date.now();\nif (msg.payload > 28 && (now - lastAlert) > 300000) {\n  flow.set('lastTempAlert', now);\n  msg.to = 'minerandon@gmail.com';\n  msg.topic = '[ALERTA] Temperatura Alta - Casa Inteligente';\n  msg.payload = 'ALERTA DE TEMPERATURA!\\n\\nTemperatura acima do limite configurado.\\nLeitura: ' + msg.payload.toFixed(1) + 'C (limite: 28C)\\nHorario: ' + new Date().toLocaleString('pt-BR');\n  return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "", "finalize": "", "libs": [],
    "x": 900, "y": 60,
    "wires": [["email_alert"]]
  },
